{
  "name": "@symbio/web",
  "version": "0.1.14",
  "description": "Symbio Web 交付物：纯浏览器运行，可选经 HTTP 连接 CLI serve 后端",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../packages/ui/node_modules/vite/bin/vite.js --config ../../packages/ui/vite.config.ts",
    "build": "node ../../packages/ui/node_modules/vite/bin/vite.js build --config ../../packages/ui/vite.config.ts",
    "preview": "node ../../packages/ui/node_modules/vite/bin/vite.js preview --config ../../packages/ui/vite.config.ts"
  },
  "dependencies": {
    "@symbio/ui": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2"
  }
}
