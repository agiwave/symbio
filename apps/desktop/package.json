{
  "name": "@symbio/desktop",
  "version": "0.1.14",
  "description": "Symbio 桌面交付物：Tauri 壳，Vue 实现共享自 packages/ui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm --prefix ../../packages/ui run dev",
    "build": "npm --prefix ../../packages/ui run build",
    "tauri": "node ../../packages/ui/node_modules/@tauri-apps/cli/tauri.js",
    "stamp:dev": "node ../../scripts/tauri-binary.mjs --stamp",
    "stamp:release": "node ../../scripts/tauri-binary.mjs --stamp --release"
  },
  "dependencies": {
    "@symbio/ui": "file:../../packages/ui"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2"
  }
}